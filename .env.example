# Safe local-development defaults. Never put real secrets in this file.
RESEARCH_PLATFORM_ENVIRONMENT=development
RESEARCH_PLATFORM_LOG_LEVEL=INFO
RESEARCH_PLATFORM_DATABASE_URL=postgresql://research:research@localhost:5432/research
RESEARCH_PLATFORM_QDRANT_URL=http://localhost:6333
RESEARCH_PLATFORM_DEPENDENCY_TIMEOUT_SECONDS=2

# Required only for live OpenAlex discovery. Keep real keys out of Git.
OPENALEX_API_KEY=your_openalex_api_key

# Optional observability profile. Replace every placeholder before starting it.
RESEARCH_PLATFORM_OTLP_ENDPOINT=http://127.0.0.1:3000/api/public/otel/v1/traces
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-generated-project-public-key
LANGFUSE_SECRET_KEY=sk-lf-replace-with-generated-project-secret-key
RESEARCH_PLATFORM_TRACE_CONTENT=full
RESEARCH_PLATFORM_WORKER_METRICS_PORT=9101

# Generate unique values for local use; ENCRYPTION_KEY must be 64 hex characters.
DATABASE_URL=postgresql://postgres:replace_with_langfuse_postgres_password@langfuse-postgres:5432/postgres
SALT=replace_with_random_salt
ENCRYPTION_KEY=replace_with_64_hex_characters
NEXTAUTH_SECRET=replace_with_random_secret
LANGFUSE_POSTGRES_PASSWORD=replace_with_langfuse_postgres_password
CLICKHOUSE_PASSWORD=replace_with_clickhouse_password
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=replace_with_minio_secret
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=replace_with_minio_secret
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=replace_with_minio_secret
REDIS_AUTH=replace_with_redis_password
MINIO_ROOT_PASSWORD=replace_with_minio_password

# These project credentials must match the initialized Langfuse project keys.
LANGFUSE_INIT_ORG_ID=local-research
LANGFUSE_INIT_ORG_NAME="Local Research"
LANGFUSE_INIT_PROJECT_ID=local-research-project
LANGFUSE_INIT_PROJECT_NAME="Local Research"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-replace-with-generated-project-public-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-replace-with-generated-project-secret-key
